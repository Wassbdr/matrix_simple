# Copy to .env and fill in. Never commit .env (already in .gitignore).

# Loki (live log scraping for multimodal RCA)
LOKI_URL=http://localhost:3100
LOKI_NAMESPACE=sock-shop

# Prometheus (live metric scraping)
PROMETHEUS_URL=http://localhost:9090

# Optional: kubeconfig path for K8s collection scripts
KUBECONFIG=/home/you/.kube/config
